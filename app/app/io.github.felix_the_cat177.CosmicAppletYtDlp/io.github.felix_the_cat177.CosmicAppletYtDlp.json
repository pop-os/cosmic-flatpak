{
  "id": "io.github.felix_the_cat177.CosmicAppletYtDlp",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "command": "cosmic-applet-yt-dlp-dixycat",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--share=network",
    "--filesystem=xdg-download",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-music",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-applet-yt-dlp-dixycat/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-applet-yt-dlp-dixycat",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-applet-yt-dlp-dixycat /app/bin/cosmic-applet-yt-dlp-dixycat",
        "install -Dm0644 ./res/io.github.felix_the_cat177.CosmicAppletYtDlp.desktop /app/share/applications/io.github.felix_the_cat177.CosmicAppletYtDlp.desktop",
        "install -Dm0644 ./res/io.github.felix_the_cat177.CosmicAppletYtDlp.metainfo.xml /app/share/metainfo/io.github.felix_the_cat177.CosmicAppletYtDlp.metainfo.xml",
        "install -Dm0644 ./res/icons/hicolor/scalable/apps/io.github.felix_the_cat177.CosmicAppletYtDlp.svg /app/share/icons/hicolor/scalable/apps/io.github.felix_the_cat177.CosmicAppletYtDlp.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/felix-the-cat177/cosmic-applet-yt-dlp-dixycat.git",
          "tag": "v0.2.1"
        },
        "generated-sources.json"
      ]
    }
  ]
}
