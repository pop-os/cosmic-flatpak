{
  "id": "com.github.justinkelly.cosmic-ext-kickoff-launcher",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "/app/launch-applet.sh",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.login1",
    "--filesystem=host-os:ro",
    "--filesystem=xdg-data/applications:ro",
    "--filesystem=xdg-data/icons:ro",
    "--filesystem=~/.local/bin:ro",
    "--filesystem=/var/lib/flatpak/exports/share:ro",
    "--filesystem=~/.local/share/flatpak/exports/share:ro",
    "--env=XDG_DATA_DIRS=/run/host/usr/share:/var/lib/flatpak/exports/share:/app/share:${HOME}/.local/share/flatpak/exports/share:${HOME}/.local/share"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-kickoff-launcher/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-kickoff-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "just build-release --verbose",
        "just prefix=/app install",
        "install -Dm0755 ./flatpak/launch-applet.sh /app/launch-applet.sh",
        "sed -i 's|^Exec=.*|Exec=/app/launch-applet.sh|' /app/share/applications/com.github.justinkelly.cosmic-ext-kickoff-launcher.desktop"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/justinkelly/cosmic-ext-kickoff-launcher.git",
          "tag": "0.1.1",
          "commit": "6f7229d07a06d2c00f28d854b6d9fa4dcd48ebbd"
        },
        "./cargo-sources.json"
      ]
    }
  ]
}
