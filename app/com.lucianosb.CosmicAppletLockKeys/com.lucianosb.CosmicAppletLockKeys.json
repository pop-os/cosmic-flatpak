{
    "id": "com.lucianosb.CosmicAppletLockKeys",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "cosmic-applet-lock-keys",
    "finish-args": [
        "--socket=wayland",
        "--share=ipc",
        "--filesystem=/sys/class/leds:ro"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/cosmic-applet-lock-keys/cargo"
        }
    },
    "modules": [
        {
            "name": "cosmic-applet-lock-keys",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline fetch --manifest-path Cargo.toml --verbose",
                "cargo --offline build --release --verbose",
                "install -Dm0755 ./target/release/cosmic-applet-lock-keys /app/bin/cosmic-applet-lock-keys",
                "install -Dm0644 ./data/com.lucianosb.CosmicAppletLockKeys.desktop /app/share/applications/com.lucianosb.CosmicAppletLockKeys.desktop",
                "install -Dm0644 ./data/com.lucianosb.CosmicAppletLockKeys.metainfo.xml /app/share/metainfo/com.lucianosb.CosmicAppletLockKeys.metainfo.xml",
                "install -Dm0644 ./data/icons/caps-lock-symbolic.svg /app/share/icons/hicolor/scalable/apps/caps-lock-symbolic.svg",
                "install -Dm0644 ./data/icons/num-lock-symbolic.svg /app/share/icons/hicolor/scalable/apps/num-lock-symbolic.svg",
                "install -Dm0644 ./data/icons/caps-lock-symbolic.svg /app/share/icons/hicolor/scalable/apps/input-keyboard-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/lucianosb/cosmic-applet-lock-keys.git",
                    "tag": "v0.1.0",
                    "commit": "b9d5318b03bafb384de838aa6f6b146a15760e78"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
