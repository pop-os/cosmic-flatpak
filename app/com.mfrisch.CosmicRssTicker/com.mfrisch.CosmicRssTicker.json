{
  "id": "com.mfrisch.CosmicRssTicker",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "cosmic-rss-ticker",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--filesystem=xdg-config/rss-ticker:rw"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-rss-ticker/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-rss-ticker",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-rss-ticker /app/bin/cosmic-rss-ticker",
        "install -Dm0644 ./data/com.mfrisch.CosmicRssTicker.desktop /app/share/applications/com.mfrisch.CosmicRssTicker.desktop"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mfrischohio/cosmic-rss-ticker.git",
          "tag": "v0.1.0",
          "commit": "8fdd6a04945147454af2fbe4b77a93fdf35d6652"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
