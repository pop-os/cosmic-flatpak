{
  "id": "io.github.Lib_LOCALE.Calculatrice",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "calculatrice",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/calculatrice/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "calculatrice",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --locked --release",
        "install -Dm0755 target/release/calculatrice /app/bin/calculatrice",
        "install -Dm0644 flatpak/io.github.Lib_LOCALE.Calculatrice.desktop /app/share/applications/io.github.Lib_LOCALE.Calculatrice.desktop",
        "install -Dm0644 flatpak/io.github.Lib_LOCALE.Calculatrice.metainfo.xml /app/share/metainfo/io.github.Lib_LOCALE.Calculatrice.metainfo.xml",
        "install -Dm0644 icons/icon.svg /app/share/icons/hicolor/scalable/apps/io.github.Lib_LOCALE.Calculatrice.svg",
        "install -Dm0644 icons/32x32.png /app/share/icons/hicolor/32x32/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 icons/64x64.png /app/share/icons/hicolor/64x64/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 icons/128x128.png /app/share/icons/hicolor/128x128/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 icons/icon.png /app/share/icons/hicolor/512x512/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 LICENSE /app/share/licenses/calculatrice/LICENSE",
        "install -Dm0644 ui/fonts/OFL.txt /app/share/licenses/calculatrice/OFL-Inter.txt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Lib-LOCALE/Calculette.git",
          "commit": "0159bc6d7ec4fbf79f4959673909cdf64a8a802f"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
