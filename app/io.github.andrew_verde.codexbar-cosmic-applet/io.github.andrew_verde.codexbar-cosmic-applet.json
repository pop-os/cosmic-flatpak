{
  "id": "io.github.andrew_verde.codexbar-cosmic-applet",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "command": "codexbar-cosmic-applet",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=xdg-config/codexbar-cosmic-applet:create",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/codexbar-cosmic-applet/cargo"
    }
  },
  "modules": [
    {
      "name": "codexbar-cosmic-applet",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/codexbar-cosmic-applet /app/bin/codexbar-cosmic-applet",
        "install -Dm0644 ./data/io.github.andrew_verde.codexbar-cosmic-applet.desktop /app/share/applications/io.github.andrew_verde.codexbar-cosmic-applet.desktop",
        "install -Dm0644 ./data/io.github.andrew_verde.codexbar-cosmic-applet.metainfo.xml /app/share/metainfo/io.github.andrew_verde.codexbar-cosmic-applet.metainfo.xml",
        "install -Dm0644 ./data/icons/scalable/apps/io.github.andrew_verde.codexbar-cosmic-applet-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.andrew_verde.codexbar-cosmic-applet-symbolic.svg",
        "install -Dm0644 ./data/icons/scalable/apps/io.github.andrew_verde.codexbar-cosmic-applet.svg /app/share/icons/hicolor/scalable/apps/io.github.andrew_verde.codexbar-cosmic-applet.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/andrew-verde/codexbar-cosmic-applet.git",
          "tag": "v0.1.0",
          "commit": "750cb0ef133a9625771b0f2fec0e9f89376caeb2"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
