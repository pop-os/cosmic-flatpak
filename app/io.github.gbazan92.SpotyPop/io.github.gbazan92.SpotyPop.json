{
  "id": "io.github.gbazan92.SpotyPop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "spotypop",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=com.system76.CosmicSettingsDaemon"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/spotypop/cargo"
    }
  },
  "modules": [
    {
      "name": "spotypop",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --workspace --verbose",
        "install -Dm0755 target/release/spotypop /app/bin/spotypop",
        "install -Dm0755 target/release/spotypop-player /app/bin/spotypop-player",
        "install -Dm0644 res/io.github.gbazan92.SpotyPop.desktop /app/share/applications/io.github.gbazan92.SpotyPop.desktop",
        "install -Dm0644 res/io.github.gbazan92.SpotyPop.metainfo.xml /app/share/metainfo/io.github.gbazan92.SpotyPop.metainfo.xml",
        "install -Dm0644 res/icons/hicolor/scalable/apps/io.github.gbazan92.SpotyPop.svg /app/share/icons/hicolor/scalable/apps/io.github.gbazan92.SpotyPop.svg",
        "install -Dm0644 res/icons/hicolor/scalable/apps/io.github.gbazan92.SpotyPop-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.gbazan92.SpotyPop-symbolic.svg",
        "install -Dm0644 -t /app/share/licenses/io.github.gbazan92.SpotyPop LICENSE THIRD-PARTY-NOTICES.md"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/gbazan92/spotypop.git",
          "tag": "v0.1.0",
          "commit": "0a3bb67520e006b54d241b5c44b87e3d5aa8c0de"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
