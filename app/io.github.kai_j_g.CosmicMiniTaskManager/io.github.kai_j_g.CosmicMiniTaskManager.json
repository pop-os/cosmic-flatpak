{
  "id": "io.github.kai_j_g.CosmicMiniTaskManager",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-mini-taskmanager",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.Config",
    "--talk-name=com.system76.CosmicSettingsDaemon.Config.*",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=host-os:ro",
    "--filesystem=/var/lib/flatpak/exports/share/applications:ro",
    "--filesystem=/var/lib/flatpak/exports/share/icons:ro",
    "--filesystem=~/.local/share/flatpak/exports/share/applications:ro",
    "--filesystem=~/.local/share/flatpak/exports/share/icons:ro",
    "--filesystem=~/.local/share/applications:ro",
    "--filesystem=~/.local/share/icons:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-mini-taskmanager/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-mini-taskmanager",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-ext-mini-taskmanager /app/bin/cosmic-ext-mini-taskmanager-bin",
        "install -Dm0755 cosmic-ext-mini-taskmanager-wrapper /app/bin/cosmic-ext-mini-taskmanager",
        "install -Dm0644 ./data/io.github.kai_j_g.CosmicMiniTaskManager.desktop /app/share/applications/io.github.kai_j_g.CosmicMiniTaskManager.desktop",
        "install -Dm0644 ./data/io.github.kai_j_g.CosmicMiniTaskManager.metainfo.xml /app/share/metainfo/io.github.kai_j_g.CosmicMiniTaskManager.metainfo.xml",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.CosmicMiniTaskManager.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.CosmicMiniTaskManager.svg",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.CosmicMiniTaskManager-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.CosmicMiniTaskManager-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Kai-J-G/cosmic-ext-mini-taskmanager.git",
          "commit": "69a988c4b62f8d6a5d10556c04e8121c7b7bf070",
          "tag": "v1.2.0"
        },
        "cargo-sources.json",
        {
          "type": "file",
          "path": "cosmic-ext-mini-taskmanager-wrapper"
        }
      ]
    }
  ]
}
