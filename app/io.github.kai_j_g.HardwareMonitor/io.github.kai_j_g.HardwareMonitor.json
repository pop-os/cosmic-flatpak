{
  "id": "io.github.kai_j_g.HardwareMonitor",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-hardware-monitor",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--filesystem=/sys/class/hwmon:ro",
    "--filesystem=/sys/class/drm:ro",
    "--filesystem=/sys/devices:ro",
    "--device=all"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-hardware-monitor/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-hardware-monitor",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-ext-hardware-monitor /app/bin/cosmic-ext-hardware-monitor",
        "install -Dm0644 ./data/io.github.kai_j_g.HardwareMonitor.desktop /app/share/applications/io.github.kai_j_g.HardwareMonitor.desktop",
        "install -Dm0644 ./data/io.github.kai_j_g.HardwareMonitor.metainfo.xml /app/share/metainfo/io.github.kai_j_g.HardwareMonitor.metainfo.xml",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.HardwareMonitor.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.HardwareMonitor.svg",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.HardwareMonitor-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.HardwareMonitor-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Kai-J-G/cosmic-ext-hardware-monitor.git",
          "tag": "v1.1.4",
          "commit": "29a029d5c693198f1b17996f5c57f0d7bf450ea7"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
