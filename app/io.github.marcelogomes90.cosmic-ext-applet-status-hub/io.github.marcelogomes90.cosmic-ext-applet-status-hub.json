{
  "id": "io.github.marcelogomes90.cosmic-ext-applet-status-hub",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-applet-status-hub",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--socket=session-bus",
    "--filesystem=xdg-config/cosmic:ro",
    "--filesystem=xdg-config/cosmic/io.github.marcelogomes90.cosmic-ext-applet-status-hub:create",
    "--filesystem=/var/lib/flatpak/exports/share/icons:ro",
    "--filesystem=~/.local/share/flatpak/exports/share/icons:ro",
    "--filesystem=/var/lib/flatpak/app:ro",
    "--filesystem=~/.local/share/flatpak/app:ro",
    "--filesystem=~/.icons:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-applet-status-hub/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-applet-status-hub",
      "buildsystem": "simple",
      "build-commands": [
        "test -f cargo/config && mv cargo/config cargo/config.toml || true",
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 target/release/cosmic-ext-applet-status-hub /app/bin/cosmic-ext-applet-status-hub",
        "install -Dm0755 target/release/cosmic-ext-applet-status-hub-dump /app/bin/cosmic-ext-applet-status-hub-dump",
        "install -Dm0644 resources/io.github.marcelogomes90.cosmic-ext-applet-status-hub.desktop /app/share/applications/io.github.marcelogomes90.cosmic-ext-applet-status-hub.desktop",
        "install -Dm0644 resources/io.github.marcelogomes90.cosmic-ext-applet-status-hub.metainfo.xml /app/share/metainfo/io.github.marcelogomes90.cosmic-ext-applet-status-hub.metainfo.xml",
        "install -Dm0644 resources/io.github.marcelogomes90.cosmic-ext-applet-status-hub.svg /app/share/icons/hicolor/scalable/apps/io.github.marcelogomes90.cosmic-ext-applet-status-hub.svg",
        "install -Dm0644 resources/io.github.marcelogomes90.cosmic-ext-applet-status-hub-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.marcelogomes90.cosmic-ext-applet-status-hub-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/marcelogomes90/cosmic-ext-applet-status-hub.git",
          "tag": "v1.5.3",
          "commit": "fe1e3c03b873b1b1d916f1c6aebbf6bd42f9b63c"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
