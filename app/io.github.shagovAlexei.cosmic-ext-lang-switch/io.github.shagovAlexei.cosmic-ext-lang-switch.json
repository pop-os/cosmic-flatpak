{
  "id": "io.github.shagovAlexei.cosmic-ext-lang-switch",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "command": "cosmic-ext-lang-switch",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--device=all",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=host-os:ro",
    "--own-name=io.github.shagovAlexei.CosmicExtLangSwitch",
    "--own-name=io.github.shagovAlexei.CosmicExtLangSwitch.Settings",
    "--system-talk-name=org.freedesktop.login1",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-lang-switch/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-lang-switch",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose -p cosmic-ext-lang-switch -p cosmic-ext-lang-switch-daemon",
        "install -Dm0755 target/release/cosmic-ext-lang-switch /app/bin/cosmic-ext-lang-switch",
        "install -Dm0755 target/release/cosmic-ext-lang-switch-daemon /app/bin/cosmic-ext-lang-switch-daemon",
        "install -Dm0644 res/io.github.shagovAlexei.cosmic-ext-lang-switch.desktop /app/share/applications/io.github.shagovAlexei.cosmic-ext-lang-switch.desktop",
        "install -Dm0644 res/io.github.shagovAlexei.cosmic-ext-lang-switch.metainfo.xml /app/share/metainfo/io.github.shagovAlexei.cosmic-ext-lang-switch.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/shagovAlexei/cosmic-ext-lang-switch.git",
          "tag": "v0.1.1",
          "commit": "1dbc5ad0d9e479178d64bdc16c41e6e462ad105a"
        },
        "./cargo-sources.json"
      ]
    }
  ]
}
