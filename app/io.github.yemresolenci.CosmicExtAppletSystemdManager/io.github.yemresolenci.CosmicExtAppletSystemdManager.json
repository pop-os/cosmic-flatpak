{
  "id": "io.github.yemresolenci.CosmicExtAppletSystemdManager",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-applet-systemd-manager",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=xdg-config/CosmicExtAppletSystemdManager:create",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--system-talk-name=org.freedesktop.systemd1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-applet-systemd-manager/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-applet-systemd-manager",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 target/release/cosmic-ext-applet-systemd-manager /app/bin/cosmic-ext-applet-systemd-manager",
        "install -Dm0644 res/io.github.yemresolenci.CosmicExtAppletSystemdManager.desktop /app/share/applications/io.github.yemresolenci.CosmicExtAppletSystemdManager.desktop",
        "install -Dm0644 res/io.github.yemresolenci.CosmicExtAppletSystemdManager.metainfo.xml /app/share/metainfo/io.github.yemresolenci.CosmicExtAppletSystemdManager.metainfo.xml",
        "install -Dm0644 res/icons/hicolor/scalable/apps/io.github.yemresolenci.CosmicExtAppletSystemdManager.svg /app/share/icons/hicolor/scalable/apps/io.github.yemresolenci.CosmicExtAppletSystemdManager.svg",
        "install -Dm0644 res/icons/hicolor/symbolic/apps/io.github.yemresolenci.CosmicExtAppletSystemdManager-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.yemresolenci.CosmicExtAppletSystemdManager-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/yemreSolenci/cosmic-ext-systemd-manager.git",
          "tag": "v0.1.0",
          "commit": "3cc39d69c1db8725e8d3e158c4747062c2d12b8b"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
