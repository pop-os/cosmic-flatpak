{
  "id": "org.cosmic_utils.CosmicExtAppletContainerManager",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-applet-container-manager",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=xdg-config/cosmic:rw"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-applet-container-manager/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-applet-container-manager",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline test --locked --features flatpak",
        "cargo --offline build --release --locked --features flatpak",
        "install -Dm0755 target/release/cosmic-ext-applet-container-manager /app/bin/cosmic-ext-applet-container-manager",
        "install -Dm0644 target/xdgen/app.desktop /app/share/applications/org.cosmic_utils.CosmicExtAppletContainerManager.desktop",
        "install -Dm0644 target/xdgen/app.metainfo.xml /app/share/metainfo/org.cosmic_utils.CosmicExtAppletContainerManager.metainfo.xml",
        "install -Dm0644 resources/icon-symbolic.svg /app/share/icons/hicolor/scalable/apps/org.cosmic_utils.CosmicExtAppletContainerManager-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/cosmic-utils/cosmic-ext-applet-container-manager.git",
          "tag": "0.1.0",
          "commit": "c4d5d57bb895ad6a1e77aa2c1d41e9931b064e11"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
